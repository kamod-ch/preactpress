{
  "name": "@preactpress/plugin-openapi",
  "version": "0.1.0",
  "description": "Official OpenAPI 3.x documentation plugin for PreactPress",
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "preactpress",
    "plugin"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./explorer": {
      "types": "./dist/explorer/types.d.ts",
      "default": "./dist/explorer/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@kamod-ch/preactpress": ">=2.2.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@preactpress/plugin-typedoc": "workspace:*",
    "openapi-types": "^12.1.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@kamod-ch/preactpress": "workspace:*",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
