{
  "name": "@preactpress/plugin-mermaid",
  "version": "0.1.0",
  "description": "Official Mermaid diagram plugin for PreactPress",
  "keywords": [
    "diagrams",
    "markdown",
    "mermaid",
    "plugin",
    "preactpress"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src/style.css",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./style.css": "./src/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@kamod-ch/preactpress": "workspace:*",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@kamod-ch/preactpress": ">=2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
