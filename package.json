{
  "name": "preactpress",
  "version": "0.1.0",
  "description": "Vite and Preact powered static site generator",
  "type": "module",
  "bin": {
    "preactpress": "./bin/preactpress.mjs"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "src/client",
    "src/shared",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./config": {
      "types": "./dist/node/config-helpers.d.ts",
      "default": "./dist/node/config-helpers.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "preactpress": "node ./bin/preactpress.mjs",
    "dev": "node ./bin/preactpress.mjs dev templates/default",
    "dev:templates": "node ./scripts/dev-all-templates.mjs",
    "preview": "node ./bin/preactpress.mjs build templates/default && node ./bin/preactpress.mjs preview templates/default"
  },
  "dependencies": {
    "@docsearch/css": "^4.6.3",
    "@docsearch/js": "^4.6.3",
    "@mdx-js/rollup": "^3.1.1",
    "@preact/preset-vite": "^2.10.5",
    "@shikijs/transformers": "^4.2.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-mathjax3": "^5.2.0",
    "minimist": "^1.2.8",
    "node-html-parser": "^7.1.0",
    "picocolors": "^1.1.1",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0",
    "remark-frontmatter": "^5.0.0",
    "shiki": "^3.15.0",
    "sirv": "^3.0.2",
    "tinyglobby": "^0.2.15",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
